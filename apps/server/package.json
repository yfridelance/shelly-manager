    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "typebox": "^1.3.37"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.4"
  }
}
